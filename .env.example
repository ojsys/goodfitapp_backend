# Django Settings
DJANGO_SETTINGS_MODULE=goodfit_api.settings.production
SECRET_KEY=your-secret-key-here-change-this
DJANGO_DEBUG=False
ALLOWED_HOSTS=your-app-name.onrender.com,localhost

# Database (Render will provide this automatically)
DATABASE_URL=postgresql://user:password@host:port/database

# CORS Settings
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
CORS_ALLOW_ALL_ORIGINS=True

# Email Settings (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@goodfit.com
ADMIN_EMAIL=admin@goodfit.com

# Redis (optional, for caching)
REDIS_URL=redis://127.0.0.1:6379/1

# --- A Good Fit accounts (Phase 1) ---
# Fernet key for encrypted birthdays. Set once and never change it, or stored
# birthdays become unreadable. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BIRTHDAY_ENCRYPTION_KEY=
# Sign in with Apple: the iOS bundle ID (comma-separated if more than one)
APPLE_CLIENT_IDS=
# Google OAuth client IDs accepted for Google sign-in (iOS, Android, web)
GOOGLE_CLIENT_IDS=
# Base URL used in password reset emails
PUBLIC_BASE_URL=https://goodfit.gitako.com

# Create a route: OSRM-compatible routing per profile, OpenTopoData-style elevation.
ROUTING_URL_BIKE=https://routing.openstreetmap.de/routed-bike
ROUTING_URL_FOOT=https://routing.openstreetmap.de/routed-foot
ELEVATION_URL=https://api.opentopodata.org/v1/srtm30m
FREE_ROUTE_LIMIT=5
