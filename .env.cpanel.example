# ---------------------------------------------------------------------------
# GoodFit API — cPanel environment
#
# Copy to `.env` in the application root (next to passenger_wsgi.py) and fill
# in. Never commit the real .env: it holds your database password.
# ---------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=goodfit_api.settings.cpanel

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-freshly-generated-secret

# Domains this API answers on. No scheme, comma separated.
ALLOWED_HOSTS=api.yourdomain.com,yourdomain.com

# Required by Django for the admin login form. WITH scheme.
CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com,https://yourdomain.com

# Browser origins allowed to call the API (your web front-end).
# A mobile app does not need to be listed — CORS is a browser mechanism.
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ---------------------------------------------------------------------------
# PostgreSQL — from cPanel → PostgreSQL Databases
#
# cPanel prefixes both the database and the user with your account name,
# e.g. account_goodfit and account_goodfituser. Use the full prefixed values.
# ---------------------------------------------------------------------------
DB_NAME=cpaneluser_goodfit
DB_USER=cpaneluser_goodfituser
DB_PASSWORD=the-password-you-set-in-cpanel
DB_HOST=localhost
DB_PORT=5432

# Alternatively a single URL, which takes precedence over the fields above:
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# ---------------------------------------------------------------------------
# Paths — where Apache serves static files and uploads from.
# Use absolute paths. Replace `cpaneluser` with your account name.
# ---------------------------------------------------------------------------
STATIC_ROOT=/home/cpaneluser/public_html/static
MEDIA_ROOT=/home/cpaneluser/public_html/media
STATIC_URL=/static/
MEDIA_URL=/media/

# Leave false when cPanel already forces HTTPS, or you get a redirect loop.
SECURE_SSL_REDIRECT=False

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# REDIS_URL=redis://127.0.0.1:6379/1      # omit entirely if unavailable
# EMAIL_HOST=mail.yourdomain.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=noreply@yourdomain.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com
# ADMIN_EMAIL=you@yourdomain.com
